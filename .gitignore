# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# ── virtual environments ─────────────────────────────────────────────────
venv/
.venv/
env/

# ── harvested / downloaded imagery ───────────────────────────────────────
# lroc_fetch.py       --output defaults to ./reference_corpus
# dowload-img-various-api.py  --outdir defaults to ./data
# LRO NAC .IMG frames run 250-500 MB each; GitHub rejects files over 100 MB.
reference_corpus/
data/
*.IMG
*.imq

# ── extracted chips + model checkpoints ───────────────────────────────────
# Pipeline chip arrays and saved model weights are scratch/regenerated
# output. Curated .npy training chips under `training data/` are kept
# (mk19/mk20 read .npy as a baseline format).
*.npy
!training data/**/*.npy
*.pth
chips/
train_chips/

# ── local run output ──────────────────────────────────────────────────────
*.log
logs/
eval_result.json

# ── Claude Code session artifacts ────────────────────────────────────────
MEMORY.md

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
